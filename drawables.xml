<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Fundo dos botões flutuantes -->
    <shape android:shape="rectangle" android:id="@+id/fundo_botao" xmlns:android="http://schemas.android.com/apk/res/android">
        <solid android:color="#CC1C1C1C"/>
        <corners android:radius="12dp"/>
        <stroke android:width="1dp" android:color="#FF6B00"/>
    </shape>

    <!-- Círculo do ícone dos botões -->
    <shape android:shape="oval" android:id="@+id/circulo_botao" xmlns:android="http://schemas.android.com/apk/res/android">
        <solid android:color="#FF6B00"/>
        <size android:width="48dp" android:height="48dp"/>
    </shape>

    <!-- Borda dos itens da lista de perfis -->
    <shape android:shape="rectangle" android:id="@+id/borda_item" xmlns:android="http://schemas.android.com/apk/res/android">
        <solid android:color="@color/fundo_card"/>
        <corners android:radius="8dp"/>
        <stroke android:width="1dp" android:color="@color/borda"/>
    </shape>

    <!-- Fundo dos botões principais -->
    <shape android:shape="rectangle" android:id="@+id/botao_principal" xmlns:android="http://schemas.android.com/apk/res/android">
        <solid android:color="@color/primaria"/>
        <corners android:radius="8dp"/>
    </shape>

    <!-- Fundo dos botões secundários -->
    <shape android:shape="rectangle" android:id="@+id/botao_secundario" xmlns:android="http://schemas.android.com/apk/res/android">
        <solid android:color="@color/fundo_card_elevado"/>
        <corners android:radius="8dp"/>
        <stroke android:width="1dp" android:color="@color/borda"/>
    </shape>

    <!-- Sombra leve -->
    <shape android:shape="rectangle" android:id="@+id/sombra_leve" xmlns:android="http://schemas.android.com/apk/res/android">
        <solid android:color="@color/sombra"/>
        <corners android:radius="4dp"/>
    </shape>

</resources>
